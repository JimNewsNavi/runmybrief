---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const GOOGLE_PLUMBER_URL = "https://g.page/r/CeEP1k8UUIk_EAE/review";
---

<Layout title="Run My Brief // Plumber Reputation & Dispatch Engine">

  <!-- 1. HERO SECTION: DIRECT COMMERCIAL VALUE PROPOSITION -->
  <section class="bg-[#0F172A] text-white border-b border-slate-800 px-6 py-14 sm:py-20">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Copy -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#F59E0B]/15 border border-[#F59E0B]/40 text-[#F59E0B] font-mono text-xs font-bold uppercase tracking-wider">
          Google Local Services Rating Protection
        </div>

        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-[1.1]">
          Get more 5-star Google reviews. Catch job issues before they go public.
        </h1>

        <p class="text-base text-slate-300 leading-relaxed max-w-2xl">
          One 1-star review over a dropped boiler pressure gauge or a late part costs thousands in lost emergency callouts. When an engineer finishes a job, handover takes 10 seconds via digital invoice link or engineer QR code:
        </p>

        <ul class="space-y-2.5 text-sm text-slate-200 pt-1">
          <li class="flex items-start gap-2.5">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded bg-[#10B981] text-[#0F172A] font-bold text-xs shrink-0 mt-0.5">✓</span>
            <span><strong class="text-white">4 &amp; 5-Star Taps:</strong> Opens your Google Local Services review page immediately while the homeowner is happy.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded bg-[#F59E0B] text-[#0F172A] font-bold text-xs shrink-0 mt-0.5">!</span>
            <span><strong class="text-white">1 to 3-Star Taps:</strong> Opens a private feedback form sent straight to your office phone or email while the database logs the issue automatically.</span>
          </li>
        </ul>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a href="#sandbox" class="px-6 py-3.5 bg-[#2563EB] hover:bg-blue-600 text-white font-bold text-sm rounded shadow-sm transition">
            Test the Live Plumber Sandbox &darr;
          </a>
          <span class="text-xs font-mono text-slate-400">
            Works via SMS link, WhatsApp, or Invoice QR Code
          </span>
        </div>
      </div>

      <!-- Right Operational Flow Diagram -->
      <div class="lg:col-span-5">
        <div class="bg-[#1E293B] border border-slate-700 rounded-lg p-5 space-y-4 shadow-xl">
          <div class="flex items-center justify-between border-b border-slate-700 pb-3">
            <span class="font-mono text-xs font-bold uppercase text-slate-300">Post-Callout Workflow</span>
            <span class="font-mono text-[11px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-600">Sub-10s Customer Tap</span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="bg-[#0F172A] border border-slate-700 rounded p-3.5 flex items-center justify-between">
              <div>
                <span class="font-mono text-[10px] text-slate-400 uppercase block">Step 1 • Driveway Dispatch</span>
                <strong class="text-white text-sm">Job Marked Complete</strong>
                <p class="text-slate-400 text-xs mt-0.5">Customer receives SMS link or scans invoice QR.</p>
              </div>
              <span class="px-2.5 py-1 bg-slate-800 text-slate-200 font-mono rounded text-[11px]">SMS / QR</span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="bg-[#0F172A] border-l-4 border-[#10B981] border-t border-r border-b border-slate-700 rounded p-3">
                <span class="font-mono text-[10px] text-[#10B981] font-bold uppercase block">If Happy (4–5★)</span>
                <strong class="text-white block mt-0.5">Direct to Google</strong>
                <p class="text-slate-400 text-[11px] mt-1">Zero extra forms. Straight to your public review box.</p>
              </div>

              <div class="bg-[#0F172A] border-l-4 border-[#F59E0B] border-t border-r border-b border-slate-700 rounded p-3">
                <span class="font-mono text-[10px] text-[#F59E0B] font-bold uppercase block">If Issue (1–3★)</span>
                <strong class="text-white block mt-0.5">Office Callback Alert</strong>
                <p class="text-slate-400 text-[11px] mt-1">Private ticket logged directly for your senior engineer.</p>
              </div>
            </div>
          </div>

          <div class="bg-[#0F172A] border border-slate-700 rounded p-3 flex items-center justify-between text-xs">
            <span class="text-slate-400">Google Platform Compliance:</span>
            <span class="text-[#10B981] font-semibold">100% Compliant Public Fallback Included</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. TWO-SIDED INTERACTIVE SANDBOX -->
  <section id="sandbox" class="py-12 px-6 bg-[#F8FAFC]">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Section Header Bar -->
      <div class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-2xs">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 bg-[#2563EB] text-white font-mono text-[10px] font-bold uppercase rounded">Interactive Demo</span>
            <h2 class="text-lg font-extrabold text-[#0F172A]">Two-Sided Live System Test</h2>
          </div>
          <p class="text-xs text-slate-600 mt-1">
            Click <strong class="text-[#0F172A]">4★ or 5★</strong> on the customer phone (left) to test the Google Local Services review link, or click <strong class="text-[#0F172A]">1–3★</strong> to route an issue into the Office Dispatch table (right).
          </p>
        </div>
        <div class="text-xs font-mono text-slate-500">
          Live Dispatch Test Environment
        </div>
      </div>

      <!-- Main Two-Column Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT COLUMN: HOMEOWNER MOBILE VIEW -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="font-mono text-xs font-bold uppercase text-slate-700">Homeowner Phone Screen</span>
            <button type="button" id="btn-reset-guest-card" class="px-3 py-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-mono text-[11px] font-bold rounded transition cursor-pointer">
              &#8635; Reset Phone
            </button>
          </div>

          <!-- Realistic Mobile Device Frame -->
          <div class="bg-[#0F172A] p-3 rounded-[28px] shadow-lg border-2 border-slate-800 max-w-sm mx-auto">
            <!-- Top Speaker Notch -->
            <div class="w-16 h-1 bg-slate-700 rounded-full mx-auto mb-2.5"></div>

            <!-- Phone Screen Content -->
            <div class="bg-white text-[#0F172A] rounded-[20px] overflow-hidden border border-slate-200">
              
              <!-- Professional Plumber Banner Image -->
              <div class="relative h-28 bg-slate-900 overflow-hidden">
                <img src="https://cdn.pixabay.com/photo/2015/07/11/14/53/plumbing-840835_1280.jpg" alt="Plumbing engineer service banner" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
                <div class="absolute bottom-2.5 left-4 text-white flex items-center justify-between right-4">
                  <span class="bg-[#2563EB] text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">Gas Safe Registered</span>
                  <span class="text-[10px] text-slate-300 font-mono">Verified Callout</span>
                </div>
              </div>

              <div class="p-5">
                <!-- Company Identity -->
                <div class="flex items-center gap-3.5 border-b border-slate-200 pb-4 mb-4">
                  <div id="brand-initial" class="w-12 h-12 rounded-lg bg-[#2563EB] text-white font-black text-xl flex items-center justify-center shrink-0">
                    LP
                  </div>
                  <div>
                    <h3 id="business-name" class="text-base font-extrabold text-[#0F172A] leading-tight">London Plumbing Firm</h3>
                    <p id="greeting-text" class="text-xs text-slate-600 mt-0.5">Thanks for choosing us for your plumbing &amp; heating work today.</p>
                  </div>
                </div>

                <!-- STEP 1: RATING OPTIONS -->
                <div id="step-rating" class="space-y-2.5">
                  <p class="text-xs font-bold text-slate-800 uppercase tracking-wide mb-2">
                    How was your engineer and job today?
                  </p>
                  
                  <button type="button" data-rating="5" class="rating-btn w-full flex items-center justify-between p-3.5 rounded-lg border-2 border-slate-200 bg-white hover:border-[#2563EB] hover:bg-blue-50/40 transition text-left cursor-pointer group">
                    <div>
                      <div class="text-sm font-extrabold text-[#0F172A] group-hover:text-[#2563EB]">5★ — Spot On / First Class</div>
                      <div class="text-xs text-slate-600">On time, tidy, and job sorted properly</div>
                    </div>
                    <span class="px-2 py-1 bg-emerald-100 text-emerald-800 font-mono text-xs font-bold rounded">5★</span>
                  </button>

                  <button type="button" data-rating="4" class="rating-btn w-full flex items-center justify-between p-3.5 rounded-lg border-2 border-slate-200 bg-white hover:border-[#2563EB] hover:bg-blue-50/40 transition text-left cursor-pointer group">
                    <div>
                      <div class="text-sm font-extrabold text-[#0F172A] group-hover:text-[#2563EB]">4★ — Good Job Overall</div>
                      <div class="text-xs text-slate-600">Happy with the work carried out</div>
                    </div>
                    <span class="px-2 py-1 bg-blue-100 text-blue-800 font-mono text-xs font-bold rounded">4★</span>
                  </button>

                  <button type="button" data-rating="3" class="rating-btn w-full flex items-center justify-between p-3.5 rounded-lg border-2 border-slate-200 bg-white hover:border-[#F59E0B] hover:bg-amber-50/40 transition text-left cursor-pointer group">
                    <div>
                      <div class="text-sm font-extrabold text-[#0F172A] group-hover:text-amber-800">1–3★ — Something Needs Sorting</div>
                      <div class="text-xs text-slate-600">Request a priority callback from the office</div>
                    </div>
                    <span class="px-2 py-1 bg-amber-100 text-amber-900 font-mono text-xs font-bold rounded">Callback</span>
                  </button>
                </div>

                <!-- STEP 2: GOOGLE REDIRECT CARD (4-5 STARS) -->
                <div id="step-redirecting" class="hidden text-center py-6 space-y-3">
                  <div class="w-10 h-10 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center mx-auto font-black text-lg">
                    ★
                  </div>
                  <h4 class="text-base font-extrabold text-[#0F172A]">Thank You So Much!</h4>
                  <p class="text-xs text-slate-600">Click below to open our Google Local Services review page and share your feedback.</p>
                  <div class="pt-2">
                    <a id="manual-redirect-btn" href={GOOGLE_PLUMBER_URL} target="_blank" rel="noopener noreferrer" class="inline-block w-full py-3 bg-[#2563EB] hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition shadow-md">
                      Open Google Reviews Now &nearr;
                    </a>
                  </div>
                </div>

                <!-- STEP 3: PRIVATE ISSUE / CALLBACK FORM (1-3 STARS) -->
                <div id="step-private-feedback" class="hidden space-y-3">
                  <div class="bg-amber-50 border border-amber-200 rounded p-3">
                    <h4 class="text-xs font-extrabold text-amber-950 uppercase">Direct Office Attention</h4>
                    <p class="text-xs text-amber-900 mt-0.5">This goes straight to our dispatch manager's phone so we can put things right today.</p>
                  </div>

                  <form id="private-feedback-form" class="space-y-3">
                    <div>
                      <label class="block text-xs font-bold text-slate-800 mb-1">What needs attention?</label>
                      <textarea id="feedback-notes" required rows="3" class="w-full rounded border border-slate-300 bg-white p-2.5 text-xs text-[#0F172A] focus:border-[#2563EB] outline-none" placeholder="e.g. Radiator still cold, boiler pressure dropped, or timing issue..."></textarea>
                    </div>
                    <div>
                      <label class="block text-xs font-bold text-slate-800 mb-1">Your Name, Postcode or Phone</label>
                      <input type="text" id="feedback-contact" required class="w-full rounded border border-slate-300 bg-white p-2.5 text-xs text-[#0F172A] focus:border-[#2563EB] outline-none" placeholder="e.g. Mr. Davies • SW14 • 07700 900123" />
                    </div>
                    <button type="submit" id="feedback-submit-btn" class="w-full py-3 rounded bg-[#0F172A] hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider transition cursor-pointer">
                      Alert Office Dispatch Now
                    </button>
                  </form>

                  <!-- Compliant Public Review Fallback -->
                  <div class="text-center pt-2 border-t border-slate-100">
                    <a id="fallback-google-link" href={GOOGLE_PLUMBER_URL} target="_blank" rel="noopener noreferrer" class="text-[11px] text-slate-500 underline hover:text-slate-800">
                      Prefer to post publicly on Google instead? Click here
                    </a>
                  </div>
                </div>

                <!-- STEP 4: COMPLETION CONFIRMATION -->
                <div id="step-completed" class="hidden text-center py-6 space-y-2.5">
                  <div class="w-10 h-10 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center mx-auto font-black text-lg">
                    ✓
                  </div>
                  <h4 class="text-base font-extrabold text-[#0F172A]">Direct Notice Sent to Dispatch</h4>
                  <p class="text-xs text-slate-600">Our senior engineer has been alerted and will call you shortly to sort this out.</p>
                </div>

                <div class="mt-5 pt-3 border-t border-slate-200 flex items-center justify-between text-[10px] font-mono text-slate-500">
                  <span>LONDON PLUMBING FIRM</span>
                  <span>RUN MY BRIEF ENGINE</span>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: OFFICE DISPATCH COMMAND CENTRE -->
        <div class="lg:col-span-7 space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="font-mono text-xs font-bold uppercase text-slate-700">2. Office Dispatch &amp; Issue Log</span>
            <span id="entry-count" class="font-mono text-xs font-bold text-[#10B981]">● Live Webhook Connected</span>
          </div>

          <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
            
            <!-- Top KPI Strip -->
            <div class="grid grid-cols-3 divide-x divide-slate-200 border-b border-slate-200 bg-slate-50">
              <div class="p-4">
                <span class="font-mono text-[10px] font-bold uppercase text-slate-500 block">Sent To Google (4–5★)</span>
                <span id="kpi-public" class="text-xl font-black text-[#10B981]">142 Jobs</span>
              </div>
              <div class="p-4">
                <span class="font-mono text-[10px] font-bold uppercase text-slate-500 block">Issues Handled Privately</span>
                <span id="kpi-intercepted" class="text-xl font-black text-[#F59E0B]">19 Jobs</span>
              </div>
              <div class="p-4">
                <span class="font-mono text-[10px] font-bold uppercase text-slate-500 block">1-Star Rants Prevented</span>
                <span class="text-xl font-black text-[#0F172A]">88.2%</span>
              </div>
            </div>

            <!-- Dispatch Table -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="bg-[#0F172A] text-slate-300 font-mono text-[11px] uppercase">
                  <tr>
                    <th class="p-3.5 font-semibold">Homeowner / Postcode (Click Row)</th>
                    <th class="p-3.5 font-semibold">Customer Tap</th>
                    <th class="p-3.5 font-semibold">System Action</th>
                    <th class="p-3.5 font-semibold">Dispatch Status</th>
                  </tr>
                </thead>
                <tbody id="dashboard-rows" class="divide-y divide-slate-200 text-[#0F172A]">
                  <tr class="cursor-pointer hover:bg-slate-50 transition feedback-row bg-blue-50/70" 
                      data-guest="Mr. Arthur Pendelton • SW14" 
                      data-rating="1–3★ Issue Reported" 
                      data-route="Directed to Office -> Priority Action" 
                      data-contact="arthur.p@outlook.com • 07700 900412" 
                      data-time="Just now • Boiler Service" 
                      data-notes="Boiler pressure dropped back down to 0.5 bar two hours after engineer left. Needs quick callback to check expansion vessel.">
                    <td class="p-3.5 font-bold text-[#2563EB] underline guest-name-cell">Mr. Arthur Pendelton • SW14</td>
                    <td class="p-3.5 font-semibold text-amber-700">1–3★ Issue</td>
                    <td class="p-3.5 text-slate-600">Directed to Office</td>
                    <td class="p-3.5"><span class="px-2 py-1 bg-amber-100 text-amber-900 font-mono font-bold rounded text-[11px]">Callback Required</span></td>
                  </tr>

                  <tr class="cursor-pointer hover:bg-slate-50 transition feedback-row" 
                      data-guest="Sarah Jenkins • N1" 
                      data-rating="5★ Spot On" 
                      data-route="Direct Redirect -> Google Local Services" 
                      data-contact="Public Google Reviewer" 
                      data-time="18 mins ago • Unvented Cylinder" 
                      data-notes="Homeowner tapped 5★ on the post-job SMS card and was presented with the direct Google Local Services review link.">
                    <td class="p-3.5 font-bold text-[#0F172A] guest-name-cell">Sarah Jenkins • N1</td>
                    <td class="p-3.5 font-semibold text-emerald-700">5★ Spot On</td>
                    <td class="p-3.5 text-slate-600">Sent to Google</td>
                    <td class="p-3.5"><span class="px-2 py-1 bg-emerald-100 text-emerald-900 font-mono font-bold rounded text-[11px]">Review Link Ready</span></td>
                  </tr>

                  <tr class="cursor-pointer hover:bg-slate-50 transition feedback-row" 
                      data-guest="Kieran O'Connor • W4" 
                      data-rating="1–3★ Issue Reported" 
                      data-route="Directed to Office -> Priority Action" 
                      data-contact="07911 123456" 
                      data-time="42 mins ago • Emergency Leak" 
                      data-notes="Engineer arrived 35 minutes past the afternoon window. Office phoned customer to apologise; resolved without a negative public review.">
                    <td class="p-3.5 font-bold text-[#0F172A] guest-name-cell">Kieran O'Connor • W4</td>
                    <td class="p-3.5 font-semibold text-amber-700">1–3★ Issue</td>
                    <td class="p-3.5 text-slate-600">Directed to Office</td>
                    <td class="p-3.5"><span class="px-2 py-1 bg-slate-200 text-slate-700 font-mono font-bold rounded text-[11px]">Sorted by Office</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Selected Job Inspector Panel -->
            <div id="inspector-panel" class="p-5 bg-slate-50 border-t border-slate-200 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-2.5">
                <div>
                  <span class="font-mono text-[10px] font-bold uppercase text-[#2563EB] block">Selected Job Ticket Details</span>
                  <h4 id="inspect-guest" class="text-base font-extrabold text-[#0F172A]">Mr. Arthur Pendelton • SW14</h4>
                </div>
                <span id="inspect-time" class="font-mono text-xs text-slate-500">Just now • Boiler Service</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="bg-white p-3 rounded border border-slate-200">
                  <span class="font-mono text-[10px] uppercase text-slate-500 block">Routing Outcome</span>
                  <strong id="inspect-route" class="text-amber-800 font-bold">1–3★ Issue Reported • Directed to Office</strong>
                </div>
                <div class="bg-white p-3 rounded border border-slate-200">
                  <span class="font-mono text-[10px] uppercase text-slate-500 block">Homeowner Contact Details</span>
                  <strong id="inspect-contact" class="text-[#0F172A] font-bold">arthur.p@outlook.com • 07700 900412</strong>
                </div>
              </div>

              <div class="bg-white p-3.5 rounded border border-slate-200 text-xs">
                <span class="font-mono text-[10px] uppercase text-slate-500 block mb-1">Customer Note (Routed Directly to Office Dispatch)</span>
                <p id="inspect-notes" class="text-slate-800 leading-relaxed font-medium">
                  Boiler pressure dropped back down to 0.5 bar two hours after engineer left. Needs quick callback to check expansion vessel.
                </p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ GOOGLE_PLUMBER_URL }}>
  const CLIENTS = {
    plumbers: {
      name: "London Plumbing Firm",
      initial: "LP",
      googleReviewUrl: GOOGLE_PLUMBER_URL
    }
  };

  const DEFAULT_CONFIG = CLIENTS.plumbers;
  const urlParams = new URLSearchParams(window.location.search);
  const clientId = urlParams.get('client') || 'plumbers';
  const recipientName = urlParams.get('name');
  const activeClient = CLIENTS[clientId] || DEFAULT_CONFIG;

  const businessNameEl = document.getElementById('business-name');
  const greetingTextEl = document.getElementById('greeting-text');
  const brandInitialEl = document.getElementById('brand-initial');
  const fallbackLink = document.getElementById('fallback-google-link');
  const manualRedirectBtn = document.getElementById('manual-redirect-btn');

  if (businessNameEl) businessNameEl.textContent = activeClient.name;
  if (recipientName && greetingTextEl) {
    greetingTextEl.textContent = `Hi ${recipientName}, thanks for choosing us for your plumbing & heating work today.`;
  }
  if (brandInitialEl) brandInitialEl.textContent = activeClient.initial;
  if (fallbackLink) fallbackLink.href = activeClient.googleReviewUrl;
  if (manualRedirectBtn) manualRedirectBtn.href = activeClient.googleReviewUrl;

  const stepRating = document.getElementById('step-rating');
  const stepRedirecting = document.getElementById('step-redirecting');
  const stepPrivate = document.getElementById('step-private-feedback');
  const stepCompleted = document.getElementById('step-completed');
  const resetBtn = document.getElementById('btn-reset-guest-card');

  const tableBody = document.getElementById('dashboard-rows');
  const countBadge = document.getElementById('entry-count');
  const kpiPublic = document.getElementById('kpi-public');
  const kpiIntercepted = document.getElementById('kpi-intercepted');
  let publicCount = 142;
  let interceptedCount = 19;

  const inspectGuest = document.getElementById('inspect-guest');
  const inspectTime = document.getElementById('inspect-time');
  const inspectRoute = document.getElementById('inspect-route');
  const inspectContact = document.getElementById('inspect-contact');
  const inspectNotes = document.getElementById('inspect-notes');

  function setActiveRowStyling(activeRow) {
    document.querySelectorAll('.feedback-row').forEach((r) => {
      r.classList.remove('bg-blue-50/70');
      const nameCell = r.querySelector('.guest-name-cell');
      if (nameCell) {
        nameCell.className = 'p-3.5 font-bold text-[#0F172A] guest-name-cell';
      }
    });

    activeRow.classList.add('bg-blue-50/70');
    const activeNameCell = activeRow.querySelector('.guest-name-cell');
    if (activeNameCell) {
      activeNameCell.className = 'p-3.5 font-bold text-[#2563EB] underline guest-name-cell';
    }
  }

  function bindRowClick(row) {
    row.addEventListener('click', () => {
      setActiveRowStyling(row);

      if (inspectGuest) inspectGuest.innerText = row.dataset.guest || 'Customer';
      if (inspectTime) inspectTime.innerText = row.dataset.time || 'Just now';
      if (inspectRoute) {
        inspectRoute.innerText = `${row.dataset.rating} • ${row.dataset.route}`;
        inspectRoute.className = (row.dataset.rating || '').includes('1–3')
          ? 'text-amber-800 font-bold'
          : 'text-emerald-800 font-bold';
      }
      if (inspectContact) inspectContact.innerText = row.dataset.contact || 'Not provided';
      if (inspectNotes) inspectNotes.innerText = row.dataset.notes || '';
    });
  }

  document.querySelectorAll('.feedback-row').forEach((row) => bindRowClick(row));

  resetBtn?.addEventListener('click', () => {
    stepRating?.classList.remove('hidden');
    stepRedirecting?.classList.add('hidden');
    stepPrivate?.classList.add('hidden');
    stepCompleted?.classList.add('hidden');
  });

  // 4-5 Star Clicks -> Show Review Link Button
  document.querySelectorAll('.rating-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const stars = Number(btn.dataset.rating || 5);
      if (stars >= 4) {
        stepRating?.classList.add('hidden');
        stepRedirecting?.classList.remove('hidden');

        publicCount++;
        if (kpiPublic) kpiPublic.innerText = `${publicCount} Jobs`;

        const newRow = document.createElement('tr');
        newRow.className = 'cursor-pointer hover:bg-slate-50 transition feedback-row';
        newRow.dataset.guest = recipientName ? `${recipientName} (Live SMS Tap)` : 'Homeowner (Live SMS Tap)';
        newRow.dataset.rating = `${stars}★ Positive`;
        newRow.dataset.route = 'Direct Redirect -> Google Local Services';
        newRow.dataset.contact = 'Routed to Public Google Page';
        newRow.dataset.time = 'Just now • Live Test';
        newRow.dataset.notes = `Homeowner clicked ${stars}★ on the mobile check-in card and was presented with the Google Local Services review link button.`;

        newRow.innerHTML = `
          <td class="p-3.5 font-bold text-[#2563EB] underline guest-name-cell">${newRow.dataset.guest}</td>
          <td class="p-3.5 font-semibold text-emerald-700">${stars}★ Spot On</td>
          <td class="p-3.5 text-slate-600">Sent to Google</td>
          <td class="p-3.5"><span class="px-2 py-1 bg-emerald-100 text-emerald-900 font-mono font-bold rounded text-[11px]">Review Link Ready</span></td>
        `;

        bindRowClick(newRow);
        tableBody?.prepend(newRow);
        newRow.click();
        if (countBadge) countBadge.innerText = '● 5★ Google Link Generated';
      } else {
        stepRating?.classList.add('hidden');
        stepPrivate?.classList.remove('hidden');
      }
    });
  });

  // 1-3 Star Form Submit -> Google Apps Script + Private Dispatch Alert Row
  const privateForm = document.getElementById('private-feedback-form');
  const submitBtn = document.getElementById('feedback-submit-btn');

  privateForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending Alert...';
    }

    const notesVal = document.getElementById('feedback-notes').value.trim();
    const contactVal = document.getElementById('feedback-contact').value.trim() || 'Homeowner';

    const payload = {
      client_id: clientId || 'plumbers',
      business_name: activeClient.name,
      customer_name: recipientName || contactVal,
      customer_contact: contactVal,
      rating: '1-3 Stars',
      notes: notesVal
    };

    try {
      const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbxlFZ4_V9ePlXOnDixOiw2p6b2c4lXhdremiePpT33nKWgoflwc6W0onUPouaZ6CVFO/exec';
      await fetch(WEB_APP_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
    } catch (err) {
      console.error('Submission failed', err);
    }

    interceptedCount++;
    if (kpiIntercepted) kpiIntercepted.innerText = `${interceptedCount} Jobs`;

    const newRow = document.createElement('tr');
    newRow.className = 'cursor-pointer hover:bg-slate-50 transition feedback-row';
    newRow.dataset.guest = contactVal;
    newRow.dataset.rating = '1–3★ Issue Reported';
    newRow.dataset.route = 'Directed to Office -> Priority Action';
    newRow.dataset.contact = contactVal;
    newRow.dataset.time = 'Just now • Live Office Alert';
    newRow.dataset.notes = notesVal;

    newRow.innerHTML = `
      <td class="p-3.5 font-bold text-[#2563EB] underline guest-name-cell">${contactVal}</td>
      <td class="p-3.5 font-semibold text-amber-700">1–3★ Issue</td>
      <td class="p-3.5 text-slate-600">Directed to Office</td>
      <td class="p-3.5"><span class="px-2 py-1 bg-amber-100 text-amber-900 font-mono font-bold rounded text-[11px]">New Office Alert</span></td>
    `;

    bindRowClick(newRow);
    tableBody?.prepend(newRow);
    newRow.click();

    if (countBadge) countBadge.innerText = '● Issue Routed to Dispatch';

    stepPrivate?.classList.add('hidden');
    stepCompleted?.classList.remove('hidden');
    privateForm.reset();

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Alert Office Dispatch Now';
    }
  });
</script>