---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import '@fontsource/oswald/700.css';
import '@fontsource/jetbrains-mono/400.css';
---

<Layout title="Under Construction">
  <main class="min-h-screen bg-[#050505] text-[#FAFAFA] flex flex-col justify-between p-6 sm:p-12 border-b border-neutral-800 select-none">
    
    <!-- Top Metadata Header -->
    <div class="grid grid-cols-12 text-[10px] tracking-[0.2em] uppercase text-neutral-500 font-mono">
      <div class="col-span-6 sm:col-span-4">
        <span>// SYSTEM STATUS</span>
      </div>
      <div class="hidden sm:block sm:col-span-4 text-center">
        <span>SCHEDULED UPDATE</span>
      </div>
      <div class="col-span-6 sm:col-span-4 text-right">
        <span class="inline-block bg-neutral-800 text-neutral-300 px-2 py-0.5">
          OFFLINE
        </span>
      </div>
    </div>

    <!-- Main Message -->
    <div class="my-auto py-16 max-w-4xl">
      <p class="font-mono text-xs tracking-[0.25em] text-neutral-500 uppercase mb-4">
        [ SYSTEM NOTICE ]
      </p>
      
      <h1 class="text-6xl sm:text-8xl font-bold uppercase text-[#FAFAFA] mb-6 leading-tight" style="font-family: 'Oswald', sans-serif;">
        UNDER<br />
        <span class="text-neutral-500">CONSTRUCTION.</span>
      </h1>

      <p class="font-mono text-xs sm:text-sm text-neutral-400 max-w-md leading-relaxed mb-8">
        This site is currently undergoing scheduled development and maintenance. Please check back soon.
      </p>

      <div class="inline-flex items-center gap-3 bg-[#0B0C0E] border border-neutral-800 p-3 font-mono text-[11px] text-neutral-400">
        <span class="w-2 h-2 rounded-full bg-neutral-400 animate-pulse"></span>
        <span>MAINTENANCE IN PROGRESS</span>
      </div>
    </div>

    <!-- Bottom Footer Bar -->
    <div class="border-t border-neutral-900 pt-6 flex justify-between items-center font-mono text-[10px] uppercase tracking-widest text-neutral-600">
      <span>&copy; 2026</span>
      <span>ALL RIGHTS RESERVED</span>
    </div>

  </main>
</Layout>