---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Under Construction" } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-[#050505] text-[#FAFAFA] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#050505] text-[#FAFAFA] flex flex-col m-0 p-0">
    <slot />
  </body>
</html>