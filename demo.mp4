<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Creator Bio Conversion Teardown • runmybrief</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .font-heading { font-family: 'Bebas Neue', Impact, sans-serif; letter-spacing: 0.05em; }
  </style>
</head>
<body class="bg-[#080c14] text-neutral-100 min-h-screen antialiased flex flex-col justify-between p-4 sm:p-8">

  <!-- TOP BAR -->
  <header class="max-w-4xl w-full mx-auto flex items-center justify-between py-4 border-b border-neutral-800">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-heading text-2xl uppercase tracking-wider text-white">runmybrief</span>
    </div>
    <a href="https://calendar.app.google/LTvgrYAyFfLxxRYC9" target="_blank" rel="noopener" class="text-xs uppercase tracking-wider font-extrabold px-3.5 py-2 bg-neutral-900 border border-neutral-700 hover:border-neutral-500 rounded-lg text-neutral-200 transition">
      Book Call &rarr;
    </a>
  </header>

  <!-- MAIN SHOWCASE CONTAINER -->
  <main class="max-w-3xl w-full mx-auto py-8 sm:py-12 text-center">
    
    <!-- BADGE -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-semibold text-emerald-400 mb-4">
      <span>Interactive Intake Engine</span>
      <span class="text-neutral-600">•</span>
      <span class="text-neutral-300">Case Teardown</span>
    </div>

    <!-- HEADLINE -->
    <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight max-w-2xl mx-auto mb-3">
      Stop losing qualified buyers to static link menus.
    </h1>
    <p class="text-neutral-400 text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
      Watch how replacing a traditional Linktree with a 45-second diagnostic automatically screens traffic and routes pre-qualified leads into your pipeline.
    </p>

    <!-- VIDEO PLAYER WRAPPER (STREAMABLE 9:16 RESPONSIVE EMBED) -->
    <div class="max-w-[340px] sm:max-w-[380px] mx-auto bg-black rounded-3xl p-2 border border-neutral-800 shadow-2xl shadow-emerald-950/20 mb-10">
      <div class="relative rounded-2xl overflow-hidden aspect-[9/16] bg-neutral-950">
        <iframe 
          src="https://streamable.com/e/0n43w6?autoplay=0" 
          frameborder="0" 
          width="100%" 
          height="100%" 
          allowfullscreen 
          allow="autoplay; fullscreen"
          class="w-full h-full border-0 absolute top-0 left-0">
        </iframe>
      </div>
    </div>

    <!-- CALL TO ACTION SECTION -->
    <div class="bg-[#0f172a] border border-neutral-800 rounded-3xl p-6 sm:p-8 max-w-xl mx-auto text-left">
      <h2 class="text-xl font-bold text-white mb-2">Want this built for your channel?</h2>
      <p class="text-sm text-neutral-300 mb-6 leading-relaxed">
        Let us map your exact products, courses, or booking links into a 4-step screener. Test it in your bio for two weeks free—zero tech setup on your side.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3">
        <a href="https://calendar.app.google/LTvgrYAyFfLxxRYC9" target="_blank" rel="noopener" class="w-full sm:w-auto flex-1 text-center py-3.5 px-6 bg-emerald-400 hover:bg-emerald-300 font-extrabold rounded-xl text-black text-xs uppercase tracking-widest transition">
          Schedule Free 10-Min Setup
        </a>
        <a href="/debt-diagnostic.html" target="_blank" class="w-full sm:w-auto py-3.5 px-6 bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-200 font-bold rounded-xl text-xs uppercase tracking-widest transition text-center">
          Test Live Demo
        </a>
      </div>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="max-w-4xl w-full mx-auto py-6 border-t border-neutral-800 text-center text-xs text-neutral-500">
    &copy; 2026 runmybrief.com • Bespoke Intake Diagnostics for Creators &amp; Operators.
  </footer>

</body>
</html>
